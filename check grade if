public class checkgrade {

    public static String checkGrade(int score) {
        if (score >= 90) {
            return "A";
        } else if (score >= 80) {
            return "B";
        } else if (score >= 70) {
            return "C";
        } else {
            return "Needs improvement";
        }
    }

    public static void main(String[] args) {
        int myScore = 85;

        System.out.println("Your score: " + myScore);
        System.out.println("Your grade: " + checkGrade(myScore));
    }
}
